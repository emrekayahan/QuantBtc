# ==============================================================================
# Autonomous Quant Engine v3.0 - Configuration Template
# ==============================================================================

# === 1. OPERATOR CREDENTIALS (REQUIRED FOR LIVE TRADING) ===
# For paper trading, dummy keys can be left as-is.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# OpenRouter Free-Tier API Keys (1 to 3 keys for automatic rotation)
OPENROUTER_API_KEY_1=sk-or-v1-first_free_key
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,liquid/lfm-3-1.7b:free,google/gemma-4-31b-it:free
OPENROUTER_TIMEOUT_SECONDS=8.0

# Telegram Notifications & Remote Panic Control (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 2. DASHBOARD SECURITY (HTTP BASIC AUTH) ===
# Note: Do not use 'admin' as username. Password must be >= 16 characters.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_USERNAME=quant_operator
DASHBOARD_PASSWORD=replace_with_min_16_character_strong_password_here!

# === 3. TRADING MODE & AUTONOMY ===
# paper: zero exchange writes; live: live execution on Binance
TRADING_MODE=paper
PAPER_STARTING_USDT=30.0
PAPER_PARTIAL_FILL_PROB=0.0
AUTONOMY_START_LEVEL=0

# === 4. RISK & CAPITAL GUARDRAILS (SECTION 8 PARAMETERS) ===
TIMEFRAME=15m
MAX_OPEN_POSITIONS=2
MAX_CORRELATED_LONGS=2
DAILY_MAX_TRADES=6
MAX_POSITION_USD=25.0
SPOT_MIN_POSITION_USD=11.50
DAILY_MAX_LOSS_USD=5.0
DAILY_MAX_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=15.0

# Small Account Mode (< $100 equity) Settings
SMALL_ACCOUNT_EQUITY_USD=100.0
SMALL_ACCOUNT_MAX_RISK_PCT=1.5
MIN_NOTIONAL_RISK_EXCEPTION_PCT=3.0
MAX_MARGIN_PCT_PER_TRADE=25.0

# Risk-Based Sizing & Exposure Limits
MAX_RISK_PER_TRADE_PCT=1.0
MAX_TOTAL_OPEN_RISK_PCT=3.0
MAX_GROSS_EXPOSURE_X=3.0
SLIPPAGE_PCT=0.05
SPOT_FEE_PCT=0.10
FUTURES_FEE_PCT=0.05

# === 5. FUTURES TRADING GUARDRAILS ===
ENABLE_FUTURES=false
FUTURES_MIN_LEVEL=1
MAX_LEVERAGE=20
FUTURES_DEFAULT_LEVERAGE=3
FUTURES_MIN_USDT=3.0
FUTURES_MARGIN_USD=4.50
LIQ_BUFFER_X=2.0
FALLBACK_TO_SPOT_WHEN_FUTURES_EXHAUSTED=false
MAX_FUNDING_PCT=0.05

# === 6. UNPROTECTED EXPOSURE & EXECUTION TIMERS ===
ENTRY_ORDER_TTL_SEC=90.0
ENTRY_ORDER_POLL_SEC=2.0
DUST_MAX_USD=0.50
SL_LIMIT_BUFFER_PCT=0.20
SL_ESCALATION_SEC=20.0
SHUTDOWN_GRACE_SEC=45.0

# === 7. CAUSAL FILTERS & REGIME TELEMETRY ===
MIN_CONFIDENCE_THRESHOLD=0.68
MIN_SETUP_QUALITY=2
MIN_24H_VOLUME_USD=10000000.0
MAX_SPREAD_PCT=0.20
MAX_HOLD_BARS=32
MIN_BRIER_SAMPLES=30
MIN_LESSONS_FOR_PENALTY=8
SIGNAL_HORIZON_BARS=32
BB_TOUCH_TOL=0.002
MOMENTUM_MIN_ATR_FRAC=0.3
ADX_MIN=20.0
BLOCK_LONGS_BELOW_BTC_EMA200=true
CLOCK_WARN_MS=250
CLOCK_BLOCK_MS=800
